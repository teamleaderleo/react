+  it(
+    'keeps the empty direct HTML slot before a later outside node when becoming managed',
+    async () => {
+      const root = ReactDOMClient.createRoot(document);
+      const body = document.body;
+
+      root.render(
+        <html>
+          <head />
+          <body dangerouslySetInnerHTML={{__html: ''}} />
+        </html>,
+      );
+      await waitForAll([]);
+
+      const externalStyle = document.createElement('style');
+      externalStyle.setAttribute('data-outside-style', 'after-empty-slot');
+      externalStyle.textContent = '.after-empty-slot { color: teal; }';
+      body.appendChild(externalStyle);
+
+      root.render(
+        <html>
+          <head />
+          <body>
+            <span id="managed-empty-slot">managed</span>
+          </body>
+        </html>,
+      );
+      await waitForAll([]);
+
+      const managed = document.getElementById('managed-empty-slot');
+      expect(managed).not.toBe(null);
+      expect(Array.from(body.childNodes)).toEqual([managed, externalStyle]);
+    },
+  );
