+  it('preserves imperative attributes when a singleton is reacquired after release', async () => {
+    const root = ReactDOMClient.createRoot(document);
+    const html = document.documentElement;
+
+    root.render(
+      <html key="en" lang="en" data-react-owned="old">
+        <head />
+        <body />
+      </html>,
+    );
+    await waitForAll([]);
+
+    // Simulate state written outside React while the singleton is owned.
+    html.setAttribute('data-theme', 'dark');
+    html.setAttribute('data-next', 'external');
+
+    // A key change deletes the old HostSingleton Fiber and places a new one
+    // against the same persistent documentElement instance.
+    root.render(
+      <html key="fr" lang="fr" data-next="react">
+        <head />
+        <body />
+      </html>,
+    );
+    await waitForAll([]);
+
+    expect(document.documentElement).toBe(html);
+    // State owned by the released Fiber was removed.
+    expect(html.hasAttribute('data-react-owned')).toBe(false);
+    // State React never owned survives reacquisition.
+    expect(html.getAttribute('data-theme')).toBe('dark');
+    // New React props still win for their own keys.
+    expect(html.getAttribute('data-next')).toBe('react');
+    expect(html.getAttribute('lang')).toBe('fr');
+  });
 
