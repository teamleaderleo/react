+    head.appendChild(externalLink);
+
+    root.render(
+      <html>
+        <head>
+          <title>managed title</title>
+        </head>
+        <body />
+      </html>,
+    );
+    await waitForAll([]);
+
+    expect(head.querySelector('meta[name="managed-stale"]')).toBe(null);
+    expect(head.querySelector('title').textContent).toBe('managed title');
+    expect(head.contains(externalLink)).toBe(true);
+  });
