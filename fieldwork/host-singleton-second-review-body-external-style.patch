+  it(
+    'preserves an external style when body leaves direct HTML',
+    async () => {
+      const root = ReactDOMClient.createRoot(document);
+      const body = document.body;
+
+      root.render(
+        <html>
+          <head />
+          <body
+            dangerouslySetInnerHTML={{__html: '<div id="managed-old">old</div>'}}
+          />
+        </html>,
+      );
+      await waitForAll([]);
+
+      const externalStyle = document.createElement('style');
+      externalStyle.setAttribute('data-external-style', 'true');
+      externalStyle.textContent = '.external { color: red; }';
+      body.appendChild(externalStyle);
+
+      root.render(
+        <html>
+          <head />
+          <body>
+            <span id="managed-new">new</span>
+          </body>
+        </html>,
+      );
+      await waitForAll([]);
+
+      expect(document.getElementById('managed-old')).toBe(null);
+      expect(document.getElementById('managed-new')).not.toBe(null);
+      expect(body.contains(externalStyle)).toBe(true);
+    },
+  );
+
+  it(
+    'preserves an external style when releasing body direct HTML',
+    async () => {
