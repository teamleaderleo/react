+  it(
+    'preserves a preexisting external style when acquiring body direct HTML',
+    async () => {
+      const body = document.body;
+      const externalStyle = document.createElement('style');
+      externalStyle.setAttribute('data-external-style', 'acquire');
+      externalStyle.textContent = '.external-acquire { color: red; }';
+      body.appendChild(externalStyle);
+
+      const root = ReactDOMClient.createRoot(document);
+      root.render(
+        <html>
+          <head />
+          <body
+            dangerouslySetInnerHTML={{
+              __html: '<div id="managed-acquire">managed</div>',
+            }}
+          />
+        </html>,
+      );
+      await waitForAll([]);
+
+      expect(document.body).toBe(body);
+      expect(document.getElementById('managed-acquire')).not.toBe(null);
+      expect(body.contains(externalStyle)).toBe(true);
+    },
+  );
+
