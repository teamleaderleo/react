+  it(
+    'preserves a stable hoistable when head leaves direct HTML',
+    async () => {
+      const root = ReactDOMClient.createRoot(document);
+      const head = document.head;
+
+      root.render(
+        <html>
+          <head dangerouslySetInnerHTML={{__html: ''}} />
+          <body />
+        </html>,
+      );
+      await waitForAll([]);
+
+      root.render(
+        <html>
+          <head dangerouslySetInnerHTML={{__html: ''}} />
+          <body>
+            <meta
+              name="stable-hoistable"
+              content="keep"
+              data-meaningful="true"
+            />
+          </body>
+        </html>,
+      );
+      await waitForAll([]);
+
+      const hoistable = head.querySelector('meta[name="stable-hoistable"]');
+      expect(hoistable).not.toBe(null);
+
+      root.render(
+        <html>
+          <head>
+            <title>managed title</title>
+          </head>
+          <body>
+            <meta
+              name="stable-hoistable"
+              content="keep"
+              data-meaningful="true"
+            />
+          </body>
+        </html>,
+      );
+      await waitForAll([]);
+
+      expect(head.querySelector('meta[name="stable-hoistable"]')).toBe(
+        hoistable,
+      );
+      expect(head.contains(hoistable)).toBe(true);
+      expect(head.querySelector('title').textContent).toBe('managed title');
+    },
+  );
+
