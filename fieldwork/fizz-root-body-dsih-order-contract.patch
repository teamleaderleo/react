+  it('keeps root body direct HTML in body scope order', async () => {
+    function App() {
+      return (
+        <>
+          <div id="before-direct-html">before</div>
+          <html>
+            <head />
+            <body
+              dangerouslySetInnerHTML={{
+                __html: '<span id="inside-direct-html">inside</span>',
+              }}
+            />
+          </html>
+          <div id="after-direct-html">after</div>
+        </>
+      );
+    }
+
+    await act(() => {
+      const {pipe} = renderToPipeableStream(<App />);
+      pipe(writable);
+    });
+
+    expect(
+      Array.from(document.body.children).map(node => node.id),
+    ).toEqual([
+      'before-direct-html',
+      'inside-direct-html',
+      'after-direct-html',
+    ]);
+  });
+
