+  it('keeps scripts inert when body uses dangerouslySetInnerHTML', async () => {
+    const root = ReactDOMClient.createRoot(document);
+    const body = document.body;
+    const ownerWindow = document.defaultView;
+    ownerWindow.__opaqueBodyScriptRan = 0;
+
+    root.render(
+      <html>
+        <head />
+        <body
+          dangerouslySetInnerHTML={{
+            __html:
+              '<script>window.__opaqueBodyScriptRan++</script>' +
+              '<span id="opaque-script-control">first</span>',
+          }}
+        />
+      </html>,
+    );
+    await waitForAll([]);
+
+    expect(ownerWindow.__opaqueBodyScriptRan).toBe(0);
+    expect(document.getElementById('opaque-script-control')).not.toBe(null);
+
+    root.render(
+      <html>
+        <head />
+        <body
+          dangerouslySetInnerHTML={{
+            __html:
+              '<script>window.__opaqueBodyScriptRan++</script>' +
+              '<span id="opaque-script-control-next">second</span>',
+          }}
+        />
+      </html>,
+    );
+    await waitForAll([]);
+
+    expect(ownerWindow.__opaqueBodyScriptRan).toBe(0);
+    expect(document.getElementById('opaque-script-control-next')).not.toBe(null);
